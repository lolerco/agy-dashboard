[Unit]
Description=AGY & Hermes Transcript Archiver Daemon
Documentation=https://github.com/jakob/agy-usage-tracker
After=default.target

[Service]
Type=simple
ExecStart=/usr/local/bin/python3 /workspace/projects/programming/agy-usage-tracker/agy_archiver.py --interval 3.0 --inactivity-threshold 60.0 --index-interval 120.0
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/workspace/projects/programming/agy-usage-tracker

# Power and battery efficiency: low IO and CPU scheduling
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
